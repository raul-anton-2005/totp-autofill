{
  "manifest_version": 3,
  "name": "TOTP Autofill",
  "version": "1.0.0",
  "description": "Genera códigos 2FA (TOTP, compatibles con Google Authenticator) y los rellena en la web actual.",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TOTP Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "fill-totp": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Rellenar el código 2FA de la web actual"
    }
  }
}
